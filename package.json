		"@types/react-dom": "^19.2.4",
		"autoprefixer": "10.4.13",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"postcss": "^8.5.26",
		"prettier": "^2.7.1",
		"tailwindcss": "^3.3.3",
		"typescript": "^5.0.4"
	},
	"lint-staged": {
		"*.{js,mjs,jsx,ts,tsx,json}": [
			"biome check --write --no-errors-on-unmatched"
