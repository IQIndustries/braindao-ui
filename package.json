		"env:dev": "vercel env pull --environment=development",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@gsap/react": "^2.1.2",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-menubar": "^1.1.15",
