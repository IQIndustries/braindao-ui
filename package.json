{
	"name": "braindao",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"format": "prettier --write \"**/*.{ts,tsx,md}\" --loglevel warn",
		"lint": "lint-staged --allow-empty",
		"prepare": "husky install",
		"test": "echo \"Next-app tests\"",
