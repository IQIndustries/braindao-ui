{
	"name": "braindao",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"format": "biome format --write .",
		"lint": "lint-staged --allow-empty",
		"prepare": "husky install",
		"test": "echo \"Next-app tests\"",
		"env:prod": "vercel env pull --environment=production",
		"env:dev": "vercel env pull --environment=development",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^13.1.0",
		"lucide-react": "^1.33.0",
		"next": "16.3.1",
		"next-intl": "^4.13.7",
		"next-themes": "^0.4.6",
		"posthog-js": "1.418.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.7.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"autoprefixer": "10.5.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.3.3",
		"typescript": "^5.0.4"
	},
	"lint-staged": {
		"*.{js,mjs,jsx,ts,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"engines": {
		"node": ">=20.9.0",
		"pnpm": ">=9"
	},
	"//pnpm": "Build-time transitives pulled in by tailwindcss 3 (sucrase, chokidar, postcss-load-config). Tailwind 4 drops these deps outright, so remove this block with that upgrade.",
	"pnpm": {
		"overrides": {
			"glob": "^10.5.0",
			"minimatch": "^9.0.7",
			"brace-expansion": "^2.1.4",
			"picomatch@2": "^2.3.2",
			"yaml": "^2.8.3"
		}
	}
}
