		"@radix-ui/react-slot": "^1.2.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.12",
		"gsap": "^3.12.5",
		"lucide-react": "^0.525.0",
		"next": "16.3.1",
		"next-intl": "^4.13.7",
		"next-themes": "^0.4.6",
		"posthog-js": "1.391.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^4.11.0",
